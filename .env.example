# Optional settings of the MCP server. Copy to .env or set them in the
# "env" block of your MCP client configuration. No secrets are needed.

# Where the Remote Script listens (must match Live's side)
ABLETON_MCP_HOST=127.0.0.1
ABLETON_MCP_PORT=9877

# Seconds to wait for a reply when the bridge gave no timeout of its own
ABLETON_MCP_TIMEOUT=20

# Pacing of commands that change the Live Set: permits per second / burst.
# 0 switches pacing off.
ABLETON_MCP_EDIT_RATE=5
ABLETON_MCP_EDIT_BURST=8

# UDP port on which analyzer frames arrive (analyzer/ or m4l/)
ABLETON_MCP_ANALYZER_PORT=7878

# Folder for snapshot_session copies (default: session_snapshots/ in this repo)
ABLETON_MCP_SNAPSHOT_DIR=

# Highest zone the assistant may use: read, reversible or destructive
ABLETON_MCP_MAX_ZONE=destructive

# DEBUG, INFO, WARNING
ABLETON_MCP_LOG_LEVEL=INFO

# The next two are read by the Remote Script, i.e. they must be set in the
# environment Live is started from (normally you leave them alone):
#   ABLETON_MCP_CONFIRM=0        bridge accepts destructive commands without confirm
#   ABLETON_MCP_JOURNAL_DIR=...  folder for journal files, or "off"
